          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"レスポンスコードが200であること\", function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"レスポンスのJSONにUserフィールドが含まれていること\", function() {",
              "    var jsonResponse = pm.response.json();",
