    {
      "name": "ログイン Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ステータスコードが200であることを確認",
              "pm.test(\"レスポンスが 200 であることを確認\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// レスポンスを JSON として取得",
              "let jsonData = pm.response.json();",
              "",
              "pm.test(\"レスポンスに ReponseCode=5 Message Tokenが含まれている\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"ResponseCode\");",
              "    pm.expect(jsonData.ResponseCode).to.equal(5);",
              "",
              "    pm.expect(jsonData).to.have.property(\"Message\");",
              "",
              "    pm.expect(jsonData).to.have.property",
              "        (\"Token\")",
              "",
              "    pm.environment.set(\"jwt_token\", jsonData.Token);",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"Username\": \"test\",\n    \"Password\": \"test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "**説明**\n\nユーザーのログイン処理を行うAPI。\n\n**JOSNデータ**\n\n``` json\n{\n    \"Username\": \"文字列\",\n    \"Email\": \"文字列\",// UsernameかEmailは必須(どちらも含んでも良い)\n    \"Password\": \"文字列\"// 必須\n}\n\n ```"
      },
      "response": []
